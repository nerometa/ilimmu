{
  "name": "ilimmu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": { "#lib/*": "./src/lib/*" },
  "packageManager": "bun@1.4.0",
  "engines": { "bun": ">=1.4.0" },
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun --bun vite build",
    "start": "bun ./build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration",
    "test:e2e": "bun --bun playwright test",
    "db:migrate": "bun scripts/migrate.ts",
    "owner": "bun scripts/owner.ts",
    "storybook": "bun node_modules/storybook/dist/bin/dispatcher.js dev -p 6006 --no-open",
    "build-storybook": "bun node_modules/storybook/dist/bin/dispatcher.js build",
    "test:http": "bun scripts/verify-http.ts",
    "test:auth": "bun scripts/verify-auth.ts",
    "test:storybook": "bun node_modules/vitest/vitest.mjs run --config .storybook/vitest.config.ts",
    "preview": "bun --env-file=.env.preview scripts/preview.ts"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "flyonui": "2.4.1",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.5",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/sveltekit": "10.6.3",
    "@sveltejs/adapter-bun": "1.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.3",
    "drizzle-kit": "0.31.11",
    "storybook": "10.6.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "trustedDependencies": []
}
